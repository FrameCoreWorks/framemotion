      ],
      "params": {
        "transition": {
          "type": "string",
          "default": "BandWipe",
          "about": "file name in gl-transitions/shaders/ without .glsl"
        },
        "settings": {
          "type": "object",
          "default": {},
          "about": "the shader's own uniforms by name; unset ones keep the defaults in its file"
        },
        "hold": {
          "type": "number",
          "default": 0.25,
          "min": 0,
          "max": 10,
          "timing": true,
          "about": "seconds on each picture before and after"
        },
        "length": {
          "type": "number",
          "default": 1,
          "min": 0.1,
          "max": 10,
          "timing": true,
          "about": "seconds the transition takes"
        },
        "ease": {
          "type": "string",
          "default": "inOut",
          "about": "linear or inOut"
        },
        "from": {
          "type": "string",
          "default": "",
          "about": "picture path inside the engines folder; empty draws a built-in one"
        },
        "to": {
          "type": "string",
          "default": "",
          "about": "picture path inside the engines folder; empty draws a built-in one"
        },
        "fps": {
          "type": "integer",
          "default": 30,
          "min": 1,
          "max": 120,
          "timing": true,
          "about": "frames per second"
        }
      }
    },
